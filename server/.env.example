# Copy this file to .env and fill in your own values before running the server.

# MongoDB connection string.
# Local Mongo:   mongodb://127.0.0.1:27017/myntra-growth-engine
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/myntra-growth-engine
MONGO_URI=mongodb://127.0.0.1:27017/myntra-growth-engine

# Port the Express + Socket.io server listens on.
PORT=5000

# Secret used to sign JWT auth tokens. Use any long random string.
JWT_SECRET=replace_this_with_a_long_random_secret

# Google Gemini API key. Get one free at https://aistudio.google.com/apikey
# Every Gemini-backed touchpoint (Opportunity "Why?", regional demand narrative,
# Revive rewrite, Prep/Coach, post-live insight, live caption translation,
# Q&A suggested replies, AI product naming from a photo, chat summarization,
# regional-signal narratives) calls Gemini through this key.
# If left empty, the app still runs with no errors: every AI route responds with
# a clearly-labeled fallback message instead of a live model response. See the
# README's "AI & growth-engine touchpoints" section for which features are
# deliberately NOT Gemini calls (those always work identically either way).
GEMINI_API_KEY=

# Not required for local use — CORS automatically reflects whatever origin the
# request came from (see server/app.js), so localhost, 127.0.0.1, and LAN IPs
# all work out of the box. Kept here in case you want to lock it down later.
CLIENT_ORIGIN=http://localhost:5173
